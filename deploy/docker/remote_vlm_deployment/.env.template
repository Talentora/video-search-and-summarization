NVIDIA_API_KEY=nvapi-YOUR_NVIDIA_API_KEY_HERE #FIXME - api key to access NIM endpoints. Should come from build.nvidia.com
OPENAI_API_KEY=sk-YOUR_OPENAI_API_KEY_HERE #FIXME - api key for the remote VLM 
NGC_API_KEY=YOUR_NGC_API_KEY_HERE #api key to pull model from NGC. Add this if you are not using the jupyter notebooks

#Use latest public image 2.3.1.
VIA_IMAGE=nvcr.io/nvidia/blueprint/vss-engine:2.3.1

#Adjust ports if needed
FRONTEND_PORT=9100
BACKEND_PORT=8100

#Change default user and pass if needed 
GRAPH_DB_USERNAME=neo4j
GRAPH_DB_PASSWORD=password123

#Update paths local paths to config files if needed. If it appears VSS is not using these configurations, then change the relative paths to absolute paths. 
CA_RAG_CONFIG=./config.yaml
GUARDRAILS_CONFIG=./guardrails

ENABLE_AUDIO=false

DISABLE_CV_PIPELINE=true

RIVA_ASR_SERVER_URI="grpc.nvcf.nvidia.com"
RIVA_ASR_GRPC_PORT=443
RIVA_ASR_SERVER_IS_NIM=true
RIVA_ASR_SERVER_USE_SSL=true
RIVA_ASR_SERVER_API_KEY=nvapi-YOUR_NVIDIA_API_KEY_HERE
RIVA_ASR_SERVER_FUNC_ID="d8dd4e9b-fbf5-4fb0-9dba-8cf436c8d965"

#Set VLM to OpenAI model 
VLM_MODEL_TO_USE=openai-compat
VIA_VLM_OPENAI_MODEL_DEPLOYMENT_NAME=gpt-4o #FIX ME - change VLM model on remote endpoint
VIA_VLM_ENDPOINT=https://api.openai.com/v1/ #FIX ME - change url to point to remote VLM endpoint. Can be any VLM with an openAI compatible API.

#Adjust misc configs if needed
# export NVIDIA_VISIBLE_DEVICES=0 #If you system has more than 1 GPU, configure which GPUs to use to run VSS. VSS can utilize multiple GPUs for lower latency summarization.

NUM_GPUS=0  # Tell VSS no local GPUs available
NUM_VLM_PROCS=1  # Use 1 process for API calls

# Add these lines to force CPU/API-only mode
CUDA_VISIBLE_DEVICES=""
FORCE_CPU_ONLY=true
SKIP_GPU_CHECK=true
DISABLE_VLM=false  # Keep VLM enabled but use API
# Mount our modified source code into the container
VIA_SRC_DIR_MODIFIED=/Users/vincent/Programming_Projects/Talentora/video-search-and-summarization/src/vss-engine
# Milvus Configuration
MILVUS_DATA_DIR=./milvus_data

GRAPH_DB_HTTP_PORT=7474
GRAPH_DB_BOLT_PORT=7687
MILVUS_DB_HOST=127.0.0.1
MILVUS_DB_PORT=19530
VLM_BATCH_SIZE=1
VSS_LOG_LEVEL=INFO
# CA-RAG Configuration (required for chat functionality)
DISABLE_CA_RAG=true


# Disable guardrails for now to focus on core functionality

DISABLE_GUARDRAILS=true


# VLM Processing Parameters (Essential for video frame processing)
VLM_DEFAULT_NUM_FRAMES_PER_CHUNK=8
VLM_INPUT_WIDTH=224
VLM_INPUT_HEIGHT=224